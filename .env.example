# URL base da API do backend (FastAPI). Ajuste conforme o ambiente.
# Como este é PHP puro (sem framework/dotenv), este arquivo é só referência —
# defina a variável de fato no servidor web:
#   - Apache/XAMPP: SetEnv DATABRIDGE_API_URL "..." no .htaccess (ver public/.htaccess)
#   - php -S (dev local): $env:DATABRIDGE_API_URL="..."; php -S localhost:8080
DATABRIDGE_API_URL=http://127.0.0.1:8010
