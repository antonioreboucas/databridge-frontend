# Sob o servidor embutido do PHP (php -S) a variável DATABRIDGE_API_URL é
# passada via $env: no PowerShell antes de subir o servidor. O Apache do
# XAMPP não herda essas variáveis de shell, então ela precisa ser definida
# aqui para o backend ser encontrado. Backend em produção no Render — pra
# testar contra o backend local (porta 8010) em vez do Render, troque o
# valor abaixo temporariamente.
<IfModule mod_env.c>
    SetEnv DATABRIDGE_API_URL "https://api-databridge.onrender.com"
</IfModule>

# DATABRIDGE_BASE_URL NÃO precisa ser definida aqui: o frontend detecta
# sozinho o subdiretório em que foi colocado (ex.: /databridge quando esta
# pasta é copiada para htdocs/databridge), então os links funcionam tanto
# na raiz quanto em qualquer subpasta do htdocs.

# URLs limpas (sem ".php"): todo o app já gera os links sem a extensão
# (ver includes/header.php e cada página em public/) — aqui é só o Apache
# aprender a servir esses caminhos.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Se alguém acessar diretamente "/pagina.php", redireciona (301) pra
    # "/pagina" — evita ter as duas URLs servindo o mesmo conteúdo.
    # Usa THE_REQUEST (a linha da requisição original) em vez de
    # REQUEST_URI porque REQUEST_URI já reflete a regra interna abaixo
    # depois que ela reescreve — checar THE_REQUEST evita loop.
    RewriteCond %{THE_REQUEST} \s/+(.*)\.php[\s?] [NC]
    RewriteRule ^ /%1 [R=301,L]

    # Serve arquivos e pastas reais normalmente (assets, etc.).
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # "/pagina" (sem extensão) -> serve "pagina.php" internamente, sem
    # mudar a URL que aparece no navegador.
    RewriteCond %{REQUEST_FILENAME}\.php -f
    RewriteRule ^(.*)$ $1.php [L,QSA]
</IfModule>
